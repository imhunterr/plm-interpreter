# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Notebooks
__marimo__/
.ipynb_checkpoints/

# Heavy / generated (keep folder structure via .gitkeep)
models/**
!models/**/
!models/**/.gitkeep
data/**
!data/**/
!data/**/.gitkeep
results/**
!results/**/
!results/**/.gitkeep
# Keep the small, paper-relevant results: reports, figures, summary tables, case-study cards
!results/*.md
!results/figures/*.png
!results/figures/*.pdf
!results/tables/**/*.csv
!results/case_studies/**/*.json
!results/case_studies/**/*.html
!results/case_studies/**/*.csv
logs/**
!logs/.gitkeep

# Weights and archives anywhere
*.safetensors
*.bin
*.pt
*.h5
*.zip

# Local only: paper sources, editor / OS files
paper/
.vscode/
.DS_Store

# Large result arrays
*.npz
